# Postgres connection string. Locally, point this at a local Postgres
# instance. On Railway, add a Postgres plugin/addon and copy its connection
# string here (as an environment variable on the web service, not committed).
DATABASE_URL="postgresql://user:password@localhost:5432/bloxmarket?schema=public"

# Signs session JWTs. Generate a real one with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-real-random-secret"

# Comma-separated list of account emails allowed into /admin/listings to
# approve or reject pending seller listings.
ADMIN_EMAILS="you@example.com"
